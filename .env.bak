# TaseDreams Environment Variables
# Update with your actual values

# ============================================
# Infrastructure Services (docker-compose.infrastructure.yaml)
# ============================================

# Bitbucket
BITBUCKET_PORT=7990
BITBUCKET_SSH_PORT=7999
# Optional plugin URLs
# SCRIPTRUNNER_PLUGIN_URL=
# CONTROLFREAK_PLUGIN_URL=

# Confluence
CONFLUENCE_PORT=8090
CONFLUENCE__DB_PORT=5432
CONFLUENCE_DB_NAME=confluence
CONFLUENCE_DB_USER=confluence
CONFLUENCE_DB_PASSWORD=confluence
CONFLUENCE_DB_HOST=infrastructure-confluence-db

# Artifactory
ARTIFACTORY_PORT=8081
ARTIFACTORY_PORT_8082=8082
ARTIFACTORY_ADMIN_USERNAME=admin
ARTIFACTORY_ADMIN_PASSWORD=admin

# LDAP
LDAP_ORGANISATION=TaseDreams
LDAP_DOMAIN=tasedreams.local
LDAP_ADMIN_PASSWORD=admin
LDAP_CONFIG_PASSWORD=config
LDAP_READONLY_USER=false
LDAP_PORT=389
LDAP_SSL_PORT=636
LDAP_ADMIN_PORT=8080

# ============================================
# Application Stack (docker-compose.yaml)
# ============================================

# SQL Server
MSSQL_SA_PASSWORD=TaseDreams2024!
MSSQL_PORT=1433

# Backend
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5000
MAX_PROJECT_NAME_LENGTH=12
PROJECT_PREFIX=oc-
CD_REPO_SUFFIX=-cd
FRONTEND_REPO_SUFFIX=-Fe

# Frontend
FRONTEND_PORT=4200
API_URL=http://backend:8080

# ============================================
# External Service Credentials
# ============================================
# Update these with your actual credentials

# Bitbucket
BITBUCKET_BASE_URL=http://localhost:7990
BITBUCKET_USERNAME=admin
BITBUCKET_PASSWORD=admin

# Artifactory
ARTIFACTORY_DEV_URL=http://localhost:8081
ARTIFACTORY_PRD_URL=http://localhost:8081/artifactory
ARTIFACTORY_USERNAME=admin
ARTIFACTORY_PASSWORD=Pass1234

# ArgoCD
ARGOCD_CONFIG_REPO_URL=
ARGOCD_CONFIG_REPO_BRANCH=main
ARGOCD_USERNAME=
ARGOCD_PASSWORD=

# OCP (OpenShift)
OCP_API_URL=
OCP_TOKEN=

# Confluence
CONFLUENCE_BASE_URL=http://localhost:8090
CONFLUENCE_USERNAME=admin
CONFLUENCE_PASSWORD=admin
CONFLUENCE_SPACE_KEY=

# LDAP (for backend connection)
LDAP_SERVER=ldap
LDAP_BASE_DN=dc=tasedreams,dc=local
LDAP_BIND_DN=cn=admin,dc=tasedreams,dc=local
LDAP_BIND_PASSWORD=admin
LDAP_USE_SSL=false
LDAP_USER_FILTER=(sAMAccountName={0})
LDAP_GROUP_FILTER=(member={0})
